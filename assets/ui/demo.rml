<rml>
    <head>
        <style>
            body {
                width: 100%;
                height: 100%;
                margin: 0;
                font-family: Roboto;
                color: #FFFFFF;
            }

            .panel {
                position: absolute;
                left: 32px;
                top: 32px;
                width: 320px;
                padding: 24px;
                background-color: #FF4400;
                font-size: 24px;
                border-radius: 12px;
            }
        </style>
    </head>
    <body>
        <div class="panel">RmlUi + WebGPU</div>
    </body>
</rml>
